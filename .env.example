# Local dev settings. Copy to .env.local (gitignored) and set a random key:
#   node -e "console.log(crypto.randomBytes(32).toString('base64url'))"
# Loaded by `npm run dev:server`; the web demo's `vite dev` reads AUTH_KEY from
# .env.local too. Never pass these as Docker build args: they'd end up in the image.
AUTH_KEY=change-me
# Any origin, so the Vite dev server on any localhost port passes CORS. The key still guards the API.
CORS_ORIGINS=*
